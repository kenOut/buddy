# Local dev default (zero-config): SQLite file next to the app.
# DATABASE_URL=sqlite+aiosqlite:///./buddy.db

# To point at real Supabase/Postgres instead, apply the Alembic migrations
# (see "Database migrations" in README.md), then set (Session pooler /
# direct connection string, asyncpg driver):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/postgres

CORS_ORIGINS=http://localhost:3000
DEMO_EMPLOYEE_EMAIL=michael.mensah@buddy.dev

# P5 — Production Security Hardening. ENVIRONMENT=production activates
# fail-closed checks on every variable below (the app refuses to start
# without them) and disables demo-data seeding — see README.md's
# "Configuration reference" for the full list and behavior in each
# environment. None of these need to be set for local dev; uncomment and
# fill in only when deploying to production.
# ENVIRONMENT=production
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# EMPLOYEE_SESSION_SECRET=
# INVITATION_TOKEN_SECRET=
# PROVISIONING_API_KEY=
# APP_BASE_URL=
# TRUSTED_HOSTS=
# ENABLE_API_DOCS=false

# P3.1 — Real Gmail SMTP Welcome Email Delivery. EMAIL_PROVIDER stays
# "mock" by default — local dev and the automated test suite never need
# any of this, and never send real email. Set EMAIL_PROVIDER=smtp only
# when you actually want the welcome email delivered somewhere real
# (see README.md's "Email delivery" section for the full manual/
# integration test procedure). Every SMTP_* value below is a real
# credential when filled in — NEVER commit a filled-in value, only this
# blank placeholder shape.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
# EMAIL_FROM_NAME=Heimdall
